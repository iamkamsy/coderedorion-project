# Copy to .env.local and fill in. Never commit real values.
# Every service is optional for local dev: without it, that feature shows a clear error state
# and the pinch + rack keep working.

# Gemini (intent -> mapping). https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional model override. Defaults to gemini-3.1-flash-lite (fast, light on free-tier rate limits).
GEMINI_MODEL=

# TigerData Postgres connection string (include ?sslmode=require).
DATABASE_URL=

# Not used yet (WP8: voice and memory).
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=
BACKBOARD_API_KEY=
